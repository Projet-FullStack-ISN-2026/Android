<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_background"
    android:padding="20dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TITRE -->
        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Inscription"
            android:textColor="@color/blanc"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp"/>

        <!-- NOM -->
        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOM"
            android:textColor="@color/blanc"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/textViewTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/editTextNom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="XXXXXXX"
            android:background="@drawable/button_transparent_white"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/blanc"
            android:textColorHint="@color/blanc"
            app:layout_constraintTop_toBottomOf="@id/textView2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- PRENOM -->
        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRENOM"
            android:textColor="@color/blanc"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/editTextNom"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/editTextPrenom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="YYYYYYY"
            android:background="@drawable/button_transparent_white"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/blanc"
            android:textColorHint="@color/blanc"
            app:layout_constraintTop_toBottomOf="@id/textView3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- EMAIL -->
        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMAIL"
            android:textColor="@color/blanc"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/editTextPrenom"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/editTextEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="hello@greatsite.com"
            android:background="@drawable/button_transparent_white"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="@color/blanc"
            android:textColorHint="@color/blanc"
            app:layout_constraintTop_toBottomOf="@id/textView4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- MOT DE PASSE -->
        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOT DE PASSE"
            android:textColor="@color/blanc"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/editTextEmail"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/editTextPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="**********"
            android:background="@drawable/button_transparent_white"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/blanc"
            android:textColorHint="@color/blanc"
            app:layout_constraintTop_toBottomOf="@id/textView5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- CONFIRMATION MOT DE PASSE -->
        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIRMER VOTRE MOT DE PASSE"
            android:textColor="@color/blanc"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/editTextPassword"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/editTextConfirmPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="**********"
            android:background="@drawable/button_transparent_white"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/blanc"
            android:textColorHint="@color/blanc"
            app:layout_constraintTop_toBottomOf="@id/textView6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BOUTON VALIDER -->

        <!-- PIED DE PAGE -->

        <Button
            android:id="@+id/btnValider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:background="@drawable/button_transparent_white"
            android:padding="12dp"
            android:text="Valider l'inscription"
            android:textColor="@color/blanc"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editTextConfirmPassword" />

        <TextView
            android:id="@+id/textViewFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TF8"
            android:textColor="@color/blanc"
            android:textSize="14sp"
            android:alpha="0.8"
            app:layout_constraintTop_toBottomOf="@id/btnValider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>