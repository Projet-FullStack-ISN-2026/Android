<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".QuestionActivity">

    <?xml version="1.0" encoding="utf-8"?>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/gradient_background"
        android:gravity="center"
        android:padding="20dp">

        <!-- Intitulé question : doit être dynamique -->

        <!-- Bouton Proposition : doit être dynamique -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="100dp"
            android:text="Intitulé de la question"
            android:textColor="@color/blanc"
            android:textSize="22sp" />

        <Button
            android:layout_width="280dp"
            android:layout_height="55dp"
            android:text="Proposition 1"
            android:textColor="@color/blanc"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_transparent_white"
            android:layout_marginBottom="25dp"
            android:letterSpacing="0.05"
            style="@style/ModernButton" />

        <!-- Bouton Proposition 2 -->
        <Button
            android:layout_width="280dp"
            android:layout_height="55dp"
            android:text="Proposition 2"
            android:textColor="@color/blanc"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_transparent_white"
            android:layout_marginBottom="25dp"
            android:letterSpacing="0.05"
            style="@style/ModernButton" />

        <!-- Bouton Proposition 3 -->
        <Button
            android:layout_width="280dp"
            android:layout_height="55dp"
            android:text="Proposition 3"
            android:textColor="@color/blanc"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_transparent_white"
            android:layout_marginBottom="25dp"
            android:letterSpacing="0.05"
            style="@style/ModernButton" />

        <!-- Bouton Proposition 4 -->

        <!-- TF8 -->
        <Button
            style="@style/ModernButton"
            android:layout_width="280dp"
            android:layout_height="55dp"
            android:background="@drawable/button_transparent_white"
            android:layout_marginBottom="25dp"
            android:letterSpacing="0.05"
            android:text="Proposition 4"
            android:textColor="@color/blanc"
            android:textSize="16sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <!-- Bouton Valider -->

            <Button
                style="@style/ModernButton"
                android:layout_width="128dp"
                android:layout_height="55dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/button_transparent_white"
                android:letterSpacing="0.05"
                android:text="Valider"
                android:layout_margin="15dp"
                android:textColor="@color/blanc"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                style="@style/ModernButton"
                android:layout_width="128dp"
                android:layout_height="55dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/button_transparent_white"
                android:letterSpacing="0.05"
                android:layout_margin="10dp"
                android:text="Suivant"
                android:textColor="@color/blanc"
                android:textSize="16sp"
                android:layout_marginStart="45dp"
                android:textStyle="bold" />

        </LinearLayout>



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:alpha="0.8"
            android:text="TF8"
            android:textColor="@color/blanc"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editTextTime2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="time" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>